# Copy to .env and fill in. The .env file is never committed.

# --- required -------------------------------------------------------------------------------------
# Mapillary client token: https://www.mapillary.com/dashboard/developers
MAPILLARY_ACCESS_TOKEN=

# --- the judging model ------------------------------------------------------------------------------
# Who answers the typed questions:
#   jev     hosted TypeSafe Jev (cloud, ~200 ms per request, billed per input token).
#           Needs TYPESAFE_API_KEY. This is the default.
#   shingi  self-hosted Shingi 27B (no key, no per-token cost). Mappity sends one place
#           at a time to its current serial worker. Large searches still take longer
#           than hosted Jev; see experiments/README.md for measurements and limits.
#           The deployed calibration has not been validated for mappity's question roles.
JEV_PROVIDER=jev
# TypeSafe Jev key, used only when JEV_PROVIDER=jev: https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=
# Where Shingi 27B answers, and the model name to ask for. The default is the Shingi 27B
# service on smarty's RTX 4090 (the same port also serves GET /v1/models).
SHINGI_URL=http://192.168.2.3:2068
SHINGI_MODEL=shingi-27b

# --- the app --------------------------------------------------------------------------------------
PORT=4321
# needle.server (https://github.com/kortexa-ai/needle.server). Without it the app still answers
# wishes; it only loses "near the aquarium" and "take me to Ballard".
NEEDLE_URL=http://localhost:4007
# OpenStreetMap's usage policies ask clients to say who they are. A URL or an email address that
# reaches you; it is sent in the User-Agent header to Overpass and Nominatim.
OSM_CONTACT=https://github.com/kortexa-ai/mappity

# --- only for making the demo video (npm run demo:*) ----------------------------------------------
# OpenAI-compatible speech servers: POST /v1/audio/speech and POST /v1/audio/transcriptions
TTS_URL=http://localhost:4003
ASR_URL=http://localhost:4002
TTS_MODEL=qwen3-tts-customvoice-1.7b
# Where the recorder finds the running app. Defaults to http://localhost:$PORT
# MAPPITY_URL=http://localhost:4321
